# docker-compose.yml 옆에 .env 로 복사 후 값 채우기.

# 이미지 태그(예: 0.1.0). 기본 latest
LITTLEDAYS_VERSION=latest
# 호스트에 노출할 포트. 기본 8080
# PORT=8080

# DB 비밀번호. DATABASE_URL 의 비밀번호와 같은 값(영숫자 권장, 특수문자는 URL 인코딩 필요)
POSTGRES_PASSWORD=
DATABASE_URL=postgres://littledays:CHANGE_ME@postgres:5432/littledays

# 브라우저 접속 주소. 리버스 프록시 뒤라면 그 https 주소
PUBLIC_URL=http://localhost:8080
# 64자 16진수. 생성: openssl rand -hex 32
SECRET_KEY=

# 파생물 생성 동시 작업 수(1-16). 기본 2
WORKER_CONCURRENCY=2

# ./data 파일 소유자. 호스트에서 id -u, id -g 값
PUID=1000
PGID=1000

# 로그 수준. 기본 info
# RUST_LOG=info
