  "query": "UPDATE users\n           SET display_name = COALESCE($2, display_name),\n               locale = COALESCE($3, locale),\n               email = CASE WHEN $4 THEN $5 ELSE email END\n           WHERE id = $1\n           RETURNING id, username, display_name, role AS \"role: Role\", email, locale,\n                     created_at, disabled_at",
