# server/ 에서 cargo run 할 때 dotenvy 가 읽는 파일. 복사해서 .env 로.
DATABASE_URL=postgres://littledays:littledays@127.0.0.1:5432/littledays
PUBLIC_URL=http://localhost:8080
# openssl rand -hex 32
SECRET_KEY=
DATA_DIR=../data
PORT=8080
# 빌드된 SPA(web/dist) 를 같은 서버에서 서빙. 비우면 API 만 서빙.
# WEB_DIR=../web/dist
RUST_LOG=info,sqlx=warn
# 로그 형식: text(기본) 또는 json. 로그는 항상 stderr.
# LOG_FORMAT=text
